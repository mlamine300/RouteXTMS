generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

//////////////////////////////////////////////
//                ENUMS                    //
////////////////////////////////////////////
enum DriverStatus {
  AVAILABLE
  ON_TRIP
  ON_BREAK
  OFF_DUTY
  INACTIVE
}

enum LicenseCategory {
  C
  CE
  C1
  C1E
  D
}

enum VehicleType {
  TRACTOR_UNIT // Porteur / TRACTEUR (Head unit)
  SEMI_TRAILER // SEMI-REMORQUE
  RIGID_TRUCK // CAMION RIGIDE / PORTEUR
  VAN // UTILITAIRE / FOURGON
  CONTAINER_CHASSIS
}

enum FuelType {
  DIESEL
  ELECTRIC
  CNG_LNG // Gaz Naturel / Gaz Liquéfié
  HYBRID
  HYDROGEN
}

enum TechnicalStatus {
  OPERATIONAL // En service
  IN_MAINTENANCE // En atelier / Réparation
  OUT_OF_SERVICE // Hors service
  RESERVED // Réservé / Immobilisé
}

enum TrailerType {
  CURTAINSIDER // Tautliner / Bâchée (Side-loading)
  BOX_TRAILER // Fourgon (Rigid wall)
  REEFER // Frigorifique (Refrigerated)
  FLATBED // Plateau
  CONTAINER_CHASSIS // Châssis porte-conteneur
  TANKER // Citerne (Liquid/Gas)
  TIPPER // Benne (Bulk cargo)
}

enum TrailerStatus {
  AVAILABLE // Parked at yard / Ready for hookup
  ATTACHED // Coupled to a tractor unit
  IN_MAINTENANCE // In workshop
  OUT_OF_SERVICE // Decommissioned / Damaged
}

//////////////////////////////////////////////
//                MODELS                   //
////////////////////////////////////////////

model User {
  id String @id @default(uuid())

  firstName String
  lastName  String

  email String @unique

  username String @unique

  passwordHash String

  refreshTokens String[]

  phone String?

  avatarUrl String?

  language String @default("fr")

  isActive Boolean @default(true)

  isLocked Boolean @default(false)

  emailVerified Boolean @default(false)

  lastLoginAt DateTime?

  passwordChangedAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  deletedAt DateTime?

  roleId String

  branchId String?
  driver   Driver?

  @@index([email])
  @@index([username])
  @@index([roleId])
  @@index([branchId])
  @@map("users")
}

model Driver {
  id         String  @id @default(uuid())
  userId     String? @unique @map("user_id")
  firstName  String  @map("first_name")
  lastName   String  @map("last_name")
  phone      String
  email      String? @unique
  isEmployee Boolean @default(true) @map("is_employee")
  employeeId String  @map("employee_id")

  // Permis et Conformité
  licenseNumber         String            @unique @map("license_number")
  licenseCategories     LicenseCategory[] @map("license_categories")
  licenseExpiresAt      DateTime          @map("license_expires_at") @db.Date
  medicalCheckExpiresAt DateTime?         @map("medical_check_expires_at") @db.Date
  // Formation Initiale Minimale Obligatoire
  fimoExpiresAt         DateTime?         @map("fimo_expires_at") @db.Date

  // Statut et Disponibilité
  status   DriverStatus @default(AVAILABLE)
  isActive Boolean      @default(true) @map("is_active")

  // Position GPS (Stockée sous forme de latitude / longitude pour Prisma)
  currentLat         Float?    @map("current_lat")
  currentLng         Float?    @map("current_lng")
  lastLocationUpdate DateTime? @map("last_location_update")

  // Métadonnées
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime?  @map("deleted_at")

  // Relations
  user              User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  assignedVehicle   Vehicle?          @relation(fields: [assignedVehicleId], references: [id])
  assignedVehicleId String?           @unique @map("assigned_vehicle_id")
  statusLogs        DriverStatusLog[]
  shipments         Shipment[]

  @@map("drivers")
}

model Vehicle {
  id          String          @id @default(uuid())
  fleetNumber String?         @unique @map("fleet_number") // Internal code (ex: "TRK-042")
  plateNumber String          @unique @map("plate_number")
  vin         String?         @unique @map("vin") // Vehicle Identification Number (Chassis N°)
  make        String // Brand (Volvo, Scania, Mercedes-Benz, etc.)
  model       String
  year        Int
  type        VehicleType     @default(RIGID_TRUCK)
  fuelType    FuelType        @default(DIESEL) @map("fuel_type")
  status      TechnicalStatus @default(OPERATIONAL)

  // --- CAPACITY & DIMENSIONS ---
  maxPayloadKg  Float  @map("max_payload_kg") // Gross payload (Charge utile max en KG)
  maxVolumeM3   Float  @map("max_volume_m3") // Volume capacity in m³
  euroPalletCap Int?   @map("euro_pallet_cap") // Max Euro-pallets capacity (ex: 33)
  grossWeightKg Float? @map("gross_weight_kg") // PTAC (Poids Total Autorisé en Charge)
  curbWeightKg  Float? @map("curb_weight_kg") // Poids à vide

  // --- SPECIALIZED LOGISTICS FEATURES ---
  isRefrigerated  Boolean @default(false) @map("is_refrigerated")
  tempMinCelsius  Float?  @map("temp_min_celsius") // For cold chain transport (-20°C)
  tempMaxCelsius  Float?  @map("temp_max_celsius") // (+15°C)
  hasTailLift     Boolean @default(false) @map("has_tail_lift") // Hayon élévateur
  hasHazardousAdr Boolean @default(false) @map("has_hazardous_adr") // Transport de matières dangereuses (ADR)

  // --- REGULATORY & MAINTENANCE COMPLIANCE ---
  insuranceNumber     String?   @map("insurance_number")
  insuranceExpiresAt  DateTime? @map("insurance_expires_at") @db.Date
  inspectionExpiresAt DateTime? @map("inspection_expires_at") @db.Date // Controle technique
  tachographExpiresAt DateTime? @map("tachograph_expires_at") @db.Date // Inspection tachygraphe

  // --- ODOMETER & TELEMATICS (IoT Integration) ---
  currentOdometerKm  Float   @default(0) @map("current_odometer_km")
  telematicsDeviceId String? @unique @map("telematics_device_id") // OBD / Samsara / Geotab ID
  fuelConsumptionAvg Float?  @map("fuel_consumption_avg") // L/100km or kWh/100km

  // --- METADATA & TIMESTAMPS ---
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // --- RELATIONS ---
  assignedDriverId String? @unique @map("assigned_driver_id")
  // assignedDriver        Driver?   @relation(fields: [assignedDriverId], references: [id], onDelete: SetNull)

  // Coupling relation (e.g. Tractor unit attached to a Semi-Trailer)
  attachedTrailerId String?  @unique @map("attached_trailer_id")
  attachedTrailer   Trailer? @relation("VehicleToTrailer")
  //parentTractor         Vehicle?  @relation("TractorTrailer")

  shipments       Shipment[]
  maintenanceLogs VehicleMaintenance[]
  driver          Driver?

  @@map("vehicles")
}

model Trailer {
  id          String        @id @default(uuid())
  fleetNumber String?       @unique @map("fleet_number") // Internal code (ex: "TRL-102")
  plateNumber String        @unique @map("plate_number")
  vin         String?       @unique @map("vin") // Chassis serial number
  make        String // Schmitz Cargobull, Krone, Wielton, etc.
  model       String?
  year        Int
  type        TrailerType   @default(CURTAINSIDER)
  status      TrailerStatus @default(AVAILABLE)

  // --- CAPACITY & DIMENSIONS ---
  maxPayloadKg         Float  @map("max_payload_kg") // Max load weight (Charge utile)
  maxVolumeM3          Float  @map("max_volume_m3") // Volume in m³
  euroPalletCap        Int    @default(33) @map("euro_pallet_cap") // Default standard semi = 33 pallets
  internalHeightMeters Float? @map("internal_height_meters") // Crucial for mega-trailers (e.g. 3m height)
  grossWeightKg        Float? @map("gross_weight_kg") // PTAC

  // --- SPECIALIZED LOGISTICS & EQUIPMENT ---
  isRefrigerated    Boolean @default(false) @map("is_refrigerated")
  reeferEngineHours Float?  @map("reefer_engine_hours") // Hours on cooling unit (for maintenance)
  tempMinCelsius    Float?  @map("temp_min_celsius")
  tempMaxCelsius    Float?  @map("temp_max_celsius")

  hasTailLift     Boolean @default(false) @map("has_tail_lift")
  hasHazardousAdr Boolean @default(false) @map("has_hazardous_adr")
  isDoubleDeck    Boolean @default(false) @map("is_double_deck") // Double-étage (66 pallets)

  // --- COMPLIANCE & INSPECTIONS ---
  insuranceNumber     String?   @map("insurance_number")
  insuranceExpiresAt  DateTime? @map("insurance_expires_at") @db.Date
  inspectionExpiresAt DateTime? @map("inspection_expires_at") @db.Date // Contrôle technique
  atpExpiresAt        DateTime? @map("atp_expires_at") @db.Date // ATP certificate for perishable goods

  // --- TELEMATICS / TRACKING ---
  telematicsDeviceId String? @unique @map("telematics_device_id") // Trailer GPS tracker ID
  currentLat         Float?  @map("current_lat") // Standalone location when unhooked
  currentLng         Float?  @map("current_lng")

  // --- METADATA & TIMESTAMPS ---
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // --- RELATIONS ---
  // Relation to the Tractor Vehicle currently hauling this trailer
  currentTractorId String?  @unique @map("current_tractor_id")
  currentTractor   Vehicle? @relation("VehicleToTrailer", fields: [currentTractorId], references: [id], onDelete: SetNull)

  shipments       Shipment[]
  maintenanceLogs TrailerMaintenance[]

  @@map("trailers")
}

model Shipment {
  id        String   @id @default(uuid())
  code      String   @unique // Code unique ex: "SHIP-2026-001"
  status    String   @default("PLANNED") // PLANNED, IN_TRANSIT, DELIVERED, CANCELLED
  driverId  String?  @map("driver_id")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  driver     Driver?           @relation(fields: [driverId], references: [id])
  statusLogs DriverStatusLog[]
  vehicle    Vehicle?          @relation(fields: [vehicleId], references: [id])
  vehicleId  String?
  trailer    Trailer?          @relation(fields: [trailerId], references: [id])
  trailerId  String?

  @@map("shipments")
}

model VehicleMaintenance {
  id          String   @id @default(uuid())
  vehicleId   String   @map("vehicle_id")
  description String
  cost        Float
  odometerKm  Float    @map("odometer_km")
  performedAt DateTime @default(now()) @map("performed_at")
  nextDueKm   Float?   @map("next_due_km")

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@map("vehicle_maintenances")
}

//////////////////////////////////////////////
//                LOGS                     //
////////////////////////////////////////////

model TrailerMaintenance {
  id          String   @id @default(uuid())
  trailerId   String   @map("trailer_id")
  description String // e.g., "Brake pad replacement", "Reefer service"
  cost        Float
  performedAt DateTime @default(now()) @map("performed_at")

  trailer Trailer @relation(fields: [trailerId], references: [id], onDelete: Cascade)

  @@map("trailer_maintenances")
}

model DriverStatusLog {
  id             BigInt        @id @default(autoincrement())
  driverId       String        @map("driver_id")
  previousStatus DriverStatus? @map("previous_status")
  newStatus      DriverStatus  @map("new_status")
  changedAt      DateTime      @default(now()) @map("changed_at")
  shipmentId     String?       @map("shipment_id")

  // Relations
  driver   Driver    @relation(fields: [driverId], references: [id], onDelete: Cascade)
  shipment Shipment? @relation(fields: [shipmentId], references: [id], onDelete: SetNull)

  @@map("driver_status_logs")
}
